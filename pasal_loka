  book: '<svg width="44" height="44" viewBox="0 0 24 24" fill="none"><rect x="5" y="3.5" width="14.5" height="17" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M9 3.5v17M12 8h4.5M12 12h4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>',
  bag: '<svg width="44" height="44" viewBox="0 0 24 24" fill="none"><rect x="5.5" y="7" width="13" height="13" rx="3.2" stroke="currentColor" stroke-width="1.8"/><path d="M9 7V5.6A3 3 0 0 1 12 3.5a3 3 0 0 1 3 2.1V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="9.2" y="11.5" width="5.6" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1.8"/></svg>',
  other: '<svg width="44" height="44" viewBox="0 0 24 24" fill="none"><rect x="9.6" y="3" width="4.8" height="3" rx="1" stroke="currentColor" stroke-width="1.8"/><path d="M10.6 6h2.8v2.2c1.6.8 2.6 2.4 2.6 4.3v5a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3v-5c0-1.9 1-3.5 2.6-4.3V6z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.5 14h7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>'
};
const P = [
  { id: 1, name: { si: 'පළ පෑන 10ක් කටිලය', en: 'Ballpoint pens (pack of 10)' }, cat: 'write', price: 350, old: 420, stock: 25 },
  { id: 2, name: { si: 'HB පැන්සල් 12ක්', en: 'HB pencils (12 pack)' }, cat: 'write', price: 280, stock: 40 },
  { id: 3, name: { si: 'පින්සල් 12ක කටිලය', en: 'Colour pencils (12 pack)' }, cat: 'write', price: 620, old: 750, stock: 15 },
  { id: 4, name: { si: 'ජ්යාමිති පෙට්ටිය', en: 'Geometry box' }, cat: 'write', price: 850, stock: 10 },
  { id: 5, name: { si: 'පසුපස පොත 200 පිටු', en: 'Exercise book 200 pages' }, cat: 'book', price: 180, stock: 120 },
  { id: 6, name: { si: 'A4 නෝට්පද කටිලය (5ක්)', en: 'A4 notebooks (pack of 5)' }, cat: 'book', price: 950, stock: 30 },
  { id: 7, name: { si: 'සටහන් පොත් සැට් 10ක්', en: 'Notebooks (set of 10)' }, cat: 'book', price: 1450, old: 1650, stock: 12 },
  { id: 8, name: { si: 'පාසල් බෑගය (3 දෙසැට්)', en: 'School bag (3 compartments)' }, cat: 'bag', price: 4500, stock: 8 },
  { id: 9, name: { si: 'ආහාර පෙට්ටිය', en: 'Lunch box' }, cat: 'bag', price: 1500, stock: 0 },
  { id: 10, name: { si: 'වතුර බෝතලය 750ml', en: 'Water bottle 750ml' }, cat: 'other', price: 1200, stock: 20 },
  { id: 11, name: { si: 'රූලර + මකන + sharpener සැට්', en: 'Ruler + eraser + sharpener set' }, cat: 'other', price: 250, stock: 50 },
  { id: 12, name: { si: 'වර්ණ පේන් සැට් 24ක්', en: 'Poster paint set (24 colours)' }, cat: 'other', price: 1850, old: 2100, stock: 6 }
];
const FREE_LIMIT = 5000, DELIVERY_FEE = 300;
let activeCat = 'all', cart = {}, lastOrder = null;

// ==== Supabase සැකසුම් (පියවර 5C: ඔබේ keys මෙතන දමන්න) ====
const SUPABASE_URL = 'https://YOUR-PROJECT-REF.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiYOUR-ANON-PUBLIC-KEY';
const SB_ENABLED = !SUPABASE_URL.includes('YOUR-PROJECT');
const sb = SB_ENABLED ? supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

const catOf = id => CATS.find(c => c.id === id);

function setLang(l) { LANG = l; localStorage.setItem('pl-lang', l); applyLang(); }

function applyLang() {
  document.getElementById('tagline').textContent = T('tagline');
  document.getElementById('cartLabel').textContent = T('cart');
  document.getElementById('q').placeholder = T('search_ph');
  document.getElementById('emptyShop').textContent = T('empty_shop');
  document.getElementById('foot1').textContent = T('foot1');
  document.getElementById('foot2').textContent = T('foot2');
  document.getElementById('foot3').textContent = T('foot3');
  document.getElementById('cartTitle').textContent = T('your_cart');
  document.getElementById('doneTitle').textContent = T('done');
  document.getElementById('backBtnLbl').textContent = T('back');
  document.getElementById('langSi').classList.toggle('on', LANG === 'si');
  document.getElementById('langEn').classList.toggle('on', LANG === 'en');
  renderChips(); render(); updateCount();
  if (document.getElementById('cartView').style.display !== 'none') renderCart();
  if (lastOrder) fillOrderInfo();
}

function renderChips() {
  document.getElementById('chips').innerHTML = CATS.map(c =>
    `<button class="chip ${activeCat === c.id ? 'on' : ''}" onclick="activeCat='${c.id}';renderChips();render()">
      <span style="width:8px; height:8px; border-radius:999px; background:${c.color};"></span>${c.name[LANG]}
    </button>`).join('');
}

function badgeFor(p) {
  if (p.stock === 0) return `<span style="font-size:11px; padding:2px 8px; border-radius:6px; background: color-mix(in srgb, var(--kimi-color-danger) 12%, transparent); color: var(--kimi-color-danger);">${T('out')}</span>`;
  if (p.stock <= 10) return `<span style="font-size:11px; padding:2px 8px; border-radius:6px; background: color-mix(in srgb, var(--kimi-color-warning) 14%, transparent); color: var(--kimi-color-warning);">${T('low').replace('{n}', p.stock)}</span>`;
  return '';
}

function render() {
  const q = (document.getElementById('q').value || '').trim();
  const list = P.filter(p => (activeCat === 'all' || p.cat === activeCat) && (!q || p.name.si.toLowerCase().includes(q.toLowerCase()) || p.name.en.toLowerCase().includes(q.toLowerCase())));
  document.getElementById('emptyShop').style.display = list.length ? 'none' : 'block';
  document.getElementById('grid').innerHTML = list.map(p => {
    const c = catOf(p.cat);
    return `<div class="card">
      <div style="height:92px; display:flex; align-items:center; justify-content:center; background: color-mix(in srgb, ${c.color} 10%, transparent); color:${c.color}; position:relative;">
        ${ICONS[p.cat]}
        ${p.stock === 0 ? `<span style="position:absolute; top:8px; right:8px;">${badgeFor(p)}</span>` : ''}
      </div>
      <div style="padding:12px; display:flex; flex-direction:column; gap:6px; flex:1;">
        <div style="font-size:13px; color:var(--kimi-color-text-tertiary);">${c.name[LANG]}</div>
        <div style="font-size:14px; font-weight:500; line-height:1.35;">${p.name[LANG]}</div>
        <div style="display:flex; align-items:baseline; gap:8px; margin-top:auto;">
          <span class="num" style="font-size:16px; font-weight:500;">${fmt(p.price)}</span>
          ${p.old ? `<span class="num" style="font-size:12px; color:var(--kimi-color-text-quaternary); text-decoration:line-through;">${fmt(p.old)}</span>` : ''}
        </div>
        ${p.stock > 0 && p.stock <= 10 ? badgeFor(p) : ''}
        <button class="pbtn" style="margin-top:4px;" ${p.stock === 0 ? 'disabled' : ''} onclick="add(${p.id}, this)">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6.09961C12.4971 6.09961 12.9004 6.50294 12.9004 7V11.0996H17C17.4971 11.0996 17.9004 11.5029 17.9004 12C17.9004 12.4971 17.4971 12.9004 17 12.9004H12.9004V17C12.9004 17.4971 12.4971 17.9004 12 17.9004C11.5029 17.9004 11.0996 17.4971 11.0996 17V12.9004H7C6.50294 12.9004 6.09961 12.4971 6.09961 12C6.09961 11.5029 6.50294 11.0996 7 11.0996H11.0996V7C11.0996 6.50294 11.5029 6.09961 12 6.09961Z"/></svg>
          ${T('add')}
        </button>
      </div>
    </div>`;
  }).join('');
}

function add(id, btn) {
  cart[id] = (cart[id] || 0) + 1;
  updateCount();
  if (btn) {
    const orig = btn.innerHTML;
    btn.innerHTML = '<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19.3027 5.9053C19.6542 5.55397 20.2247 5.55388 20.5761 5.9053C20.9273 6.25675 20.9273 6.82734 20.5761 7.17874L9.65911 18.0948C9.30773 18.4461 8.73814 18.446 8.38665 18.0948L3.42376 13.1328C3.0726 12.7814 3.07263 12.2118 3.42376 11.8604C3.77524 11.509 4.34575 11.5089 4.6972 11.8604L9.02239 16.1856L19.3027 5.9053Z"/></svg> ' + T('added');
    setTimeout(() => { btn.innerHTML = orig; }, 900);
  }
}

function updateCount() {
  document.getElementById('cartCount').textContent = Object.values(cart).reduce((a, b) => a + b, 0);
}

function chg(id, d) {
  cart[id] = (cart[id] || 0) + d;
  if (cart[id] <= 0) delete cart[id];
  updateCount(); renderCart();
}

function totals() {
  const sub = Object.entries(cart).reduce((s, [id, q]) => s + P.find(p => p.id == id).price * q, 0);
  const delivery = sub === 0 || sub >= FREE_LIMIT ? 0 : DELIVERY_FEE;
  return { sub, delivery, total: sub + delivery, count: Object.values(cart).reduce((a, b) => a + b, 0) };
}

function renderCart() {
  const body = document.getElementById('cartBody');
  const ids = Object.keys(cart);
  if (!ids.length) {
    body.innerHTML = `<div style="text-align:center; padding:48px 16px; border:1px dashed var(--kimi-color-border); border-radius:12px;">
      <div style="font-size:15px; font-weight:500;">${T('cart_empty')}</div>
      <div style="font-size:13px; color:var(--kimi-color-text-tertiary); margin:6px 0 16px;">${T('cart_empty_sub')}</div>
      <button class="sbtn" onclick="show('shop')">${T('browse')}</button>
    </div>`;
    return;
  }
  const rows = ids.map(id => {
    const p = P.find(x => x.id == id), q = cart[id], c = catOf(p.cat);
    return `<div class="rrow" style="display:flex; align-items:center; gap:12px; padding:12px; border:1px solid var(--kimi-color-border); border-radius:12px; margin-bottom:8px;">
      <div style="width:48px; height:48px; border-radius:8px; flex:none; display:flex; align-items:center; justify-content:center; background: color-mix(in srgb, ${c.color} 10%, transparent); color:${c.color};">${ICONS[p.cat].replace('width="44" height="44"', 'width="26" height="26"')}</div>
      <div style="flex:1; min-width:0;">
        <div style="font-size:14px; font-weight:500; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${p.name[LANG]}</div>
        <div class="num" style="font-size:12px; color:var(--kimi-color-text-tertiary);">${fmt(p.price)} × ${q}</div>
      </div>
      <div style="display:flex; align-items:center; gap:6px;">
        <button class="step" onclick="chg(${id},-1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17 11.0996C17.4971 11.0996 17.9004 11.5029 17.9004 12C17.9004 12.4971 17.4971 12.9004 17 12.9004H7C6.50294 12.9004 6.09961 12.4971 6.09961 12C6.09961 11.5029 6.50294 11.0996 7 11.0996H17Z"/></svg></button>
        <span class="num" style="width:22px; text-align:center; font-size:14px;">${q}</span>
        <button class="step" onclick="chg(${id},1)"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6.09961C12.4971 6.09961 12.9004 6.50294 12.9004 7V11.0996H17C17.4971 11.0996 17.9004 11.5029 17.9004 12C17.9004 12.4971 17.4971 12.9004 17 12.9004H12.9004V17C12.9004 17.4971 12.4971 17.9004 12 17.9004C11.5029 17.9004 11.0996 17.4971 11.0996 17V12.9004H7C6.50294 12.9004 6.09961 12.4971 6.09961 12C6.09961 11.5029 6.50294 11.0996 7 11.0996H11.0996V7C11.0996 6.50294 11.5029 6.09961 12 6.09961Z"/></svg></button>
      </div>
      <div class="num" style="width:84px; text-align:right; font-size:14px; font-weight:500;">${fmt(p.price * q)}</div>
      <button class="step ractions" title="${T('remove')}" onclick="delete cart[${id}];updateCount();renderCart();"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M4.5 6.5h15M9.5 6.5V5a1.5 1.5 0 0 1 1.5-1.5h2A1.5 1.5 0 0 1 14.5 5v1.5M6.5 6.5l.8 12a2 2 0 0 0 2 1.9h5.4a2 2 0 0 0 2-1.9l.8-12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>`;
  }).join('');
  const t = totals();
  const pct = Math.min(100, Math.round(t.sub / FREE_LIMIT * 100));
  body.innerHTML = rows + `
  <div style="margin-top:16px; display:grid; grid-template-columns: 1fr; gap:16px;">
    <div>
      <div style="font-size:13px; color:var(--kimi-color-text-tertiary); margin-bottom:6px;">${t.sub >= FREE_LIMIT ? T('free_ok') : T('free_more').replace('{x}', fmt(FREE_LIMIT - t.sub))}</div>
      <div style="height:4px; border-radius:999px; background:var(--kimi-color-text-quaternary); opacity:.3; overflow:hidden;"><div style="height:100%; width:${pct}%; background:var(--kimi-color-text-primary); border-radius:999px;"></div></div>
      <div style="margin-top:16px; border:1px solid var(--kimi-color-border); border-radius:12px; padding:16px;">
        <div style="display:flex; justify-content:space-between; font-size:14px; color:var(--kimi-color-text-secondary); padding:4px 0;"><span>${T('subtotal')}</span><span class="num">${fmt(t.sub)}</span></div>
        <div style="display:flex; justify-content:space-between; font-size:14px; color:var(--kimi-color-text-secondary); padding:4px 0;"><span>${T('delivery_fee')}</span><span class="num">${t.delivery === 0 ? T('free') : fmt(t.delivery)}</span></div>
        <div style="display:flex; justify-content:space-between; font-size:17px; font-weight:500; padding:8px 0 0; margin-top:6px; border-top:1px solid var(--kimi-color-border);"><span>${T('total')}</span><span class="num">${fmt(t.total)}</span></div>
      </div>
    </div>
    <div>
      <div style="font-size:15px; font-weight:500; margin-bottom:12px;">${T('delivery_info')}</div>
      <div style="display:grid; gap:10px;">
        <input id="fName" class="inp" placeholder="${T('full_name')}">
        <input id="fPhone" class="inp" placeholder="${T('phone')}" inputmode="numeric">
        <textarea id="fAddr" class="inp" rows="2" placeholder="${T('address')}" style="resize:none;"></textarea>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          <label class="radio on" id="rHome"><input type="radio" name="dlv" checked onchange="pickDlv('rHome')"> ${T('home_delivery')}</label>
          <label class="radio" id="rPick"><input type="radio" name="dlv" onchange="pickDlv('rPick')"> ${T('pickup')}</label>
        </div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
          <label class="radio on" id="rCash"><input type="radio" name="pay" checked onchange="pickPay('rCash')"> ${T('cash')}</label>
          <label class="radio" id="rCard"><input type="radio" name="pay" onchange="pickPay('rCard')"> ${T('card')}</label>
        </div>
        <div id="formErr" style="display:none; font-size:13px; color:var(--kimi-color-danger);"></div>
        <button class="pbtn" style="padding:11px;" onclick="placeOrder(this)">${T('place_order')}</button>
      </div>
    </div>
  </div>`;
}

function pickDlv(id) { document.getElementById('rHome').classList.toggle('on', id === 'rHome'); document.getElementById('rPick').classList.toggle('on', id === 'rPick'); }
function pickPay(id) { document.getElementById('rCash').classList.toggle('on', id === 'rCash'); document.getElementById('rCard').classList.toggle('on', id === 'rCard'); }

function fillOrderInfo() {
  const o = lastOrder;
  document.getElementById('orderInfo').innerHTML =
    `${T('order_no')}: <b style="font-weight:500;">${o.no}</b><br>` +
    `${o.count} ${T('items_lbl')} · ${T('total_lbl')}: <span class="num">${fmt(o.total)}</span><br>` +
    `${T('payment_lbl')}: ${T(o.payKey)}<br>` +
    (o.dlv ? `${T('delivery_lbl')}: ${o.addr}<br>${T('est')}` : T('pickup_note'));
}

async function placeOrder(btn) {
  const name = document.getElementById('fName').value.trim();
  const phone = document.getElementById('fPhone').value.trim();
  const addr = document.getElementById('fAddr').value.trim();
  const err = document.getElementById('formErr');
  let msg = '';
  if (!name || !phone || !addr) msg = T('err_required');
  else if (!/^07\d{8}$/.test(phone.replace(/\s/g, ''))) msg = T('err_phone');
  if (msg) { err.textContent = msg; err.style.display = 'block'; return; }
  const t = totals();
  const no = 'SL-2026-' + String(Date.now()).slice(-6);
  const dlv = document.getElementById('rHome').classList.contains('on');
  const payKey = document.getElementById('rCash').classList.contains('on') ? 'cash' : 'card';
  const items = Object.entries(cart).map(([id, q]) => {
    const p = P.find(x => x.id == id);
    return { name: p.name[LANG], qty: q, price: p.price };
  });
  const orderData = {
    order_no: no, name: name, phone: phone, address: addr,
    items: items, total: t.total, payment: payKey,
    delivery_method: dlv ? 'home' : 'pickup', status: 'new'
  };
  btn.disabled = true;
  btn.textContent = T('sending');
  try {
    if (SB_ENABLED) {
      const { error } = await sb.from('orders').insert(orderData);
      if (error) throw error;
    } else {
      console.warn('Supabase keys දමා නැත — order එක browser එකේ පමණයි.');
    }
    lastOrder = { no: no, count: t.count, total: t.total, payKey: payKey, dlv: dlv, addr: addr };
    fillOrderInfo();
    cart = {}; updateCount();
    show('done');
  } catch (e) {
    err.textContent = T('err_send');
    err.style.display = 'block';
  } finally {
    btn.disabled = false;
    btn.textContent = T('place_order');
  }
}

function show(v) {
  document.getElementById('shopView').style.display = v === 'shop' ? 'block' : 'none';
  document.getElementById('cartView').style.display = v === 'cart' ? 'block' : 'none';
  document.getElementById('doneView').style.display = v === 'done' ? 'block' : 'none';
  if (v === 'cart') renderCart();
}

function resetAll() { show('shop'); render(); }

applyLang();
</script>
</div>
</body>
